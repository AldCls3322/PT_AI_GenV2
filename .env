# ── LLM Provider ─────────────────────────────────────────────
# Option A: OpenAI (recommended for quick testing)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# Option B: Local Ollama (fully free, set LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

LLM_PROVIDER=openai   # "openai" | "ollama"

# ── RAG / ChromaDB ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=banorte_docs

# RAG hyperparameters (hardcoded defaults, override here if needed)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2   # HuggingFace sentence-transformer
TOP_K=4

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./banorte.db

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
